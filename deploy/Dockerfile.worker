# syntax=docker/dockerfile:1.7
FROM ghcr.io/astral-sh/uv:0.11.33@sha256:77280f2f771df71f90786c314fe1bbc1e023feac652969bbf139c280babf2eb7 AS uv
FROM python:3.14.7-alpine3.24@sha256:05b2b8b732ecd268fee8727a369f936f022d1321b59befd13c30ede22769dcdc AS worker-core
COPY --from=uv /uv /usr/local/bin/uv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_FROZEN=1 UV_NO_DEV=1
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY AGENTS.md llms.txt agent-manifest.json SPEC.md FORMAL_MODEL.md ./
COPY src ./src
COPY schemas ./schemas
COPY fixtures ./fixtures
COPY docs ./docs
COPY packages ./packages
RUN uv sync --frozen --all-packages --extra worker --no-group dev --no-group security && \
    rm -rf /usr/local/lib/python3.14/ensurepip \
      /usr/local/lib/python3.14/site-packages/pip \
      /usr/local/lib/python3.14/site-packages/pip-26.2.1.dist-info \
      /usr/local/lib/python3.14/site-packages/setuptools \
      /usr/local/lib/python3.14/site-packages/setuptools-70.3.0.dist-info && \
    addgroup -S -g 65532 cpcf && \
    adduser -S -D -H -u 65532 -G cpcf cpcf && \
    chown -R 65532:65532 /app
USER 65532:65532
ENTRYPOINT ["uv", "run", "--frozen", "--no-sync", "cpcf-worker"]

FROM worker-core AS worker-aws-kms
RUN uv sync --frozen --all-packages --extra worker --extra aws-kms --no-group dev --no-group security

FROM worker-core AS worker-gcp-kms
RUN uv sync --frozen --all-packages --extra worker --extra gcp-kms --no-group dev --no-group security

FROM worker-core AS worker-azure-kms
RUN uv sync --frozen --all-packages --extra worker --extra azure-kms --no-group dev --no-group security

FROM worker-core AS worker-pkcs11
RUN uv sync --frozen --all-packages --extra worker --extra pkcs11 --no-group dev --no-group security

FROM worker-core AS worker
